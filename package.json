{
  "name": "aughome",
  "version": "0.1.0",
  "private": true,
  "description": "AugHome IDE — An AI-native, open-source code editor powered by Augagent",
  "type": "module",
  "workspaces": [
    "apps/*",
    "extensions/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@aughome/desktop run dev",
    "test": "node --test tests/*.test.js",
    "test:backend": "py -m unittest discover -s apps/backend/tests",
    "setup:python": "pip install -e ../augagent -e apps/backend",
    "lint": "echo \"Linting workspace...\"",
    "build": "echo \"Building workspace packages...\""
  },
  "keywords": [
    "ide",
    "code-editor",
    "augagent",
    "ai-native",
    "electron",
    "monaco-editor",
    "fastapi"
  ],
  "author": "Augmencord",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Augmencord/AugHome.git"
  },
  "bugs": {
    "url": "https://github.com/Augmencord/AugHome/issues"
  },
  "homepage": "https://github.com/Augmencord/AugHome#readme"
}
